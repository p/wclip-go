# Configuration for wclip, sourced by the systemd unit.
# Uncomment and edit as needed.

# Storage backend: bolt (persistent) or mem (in-memory, volatile).
#STORE=bolt

# Path to the bbolt database file (only used when STORE=bolt).
DB_PATH=/var/lib/wclip/wclip.db

# Address(es) to bind to (listen on).
#
# Default (BIND unset): listen on all available loopback addresses
# (127.0.0.1 and, if available, [::1]). Best-effort: an unavailable
# loopback is skipped with a log message rather than refusing to start.
#
# To expose wclip beyond loopback, set BIND explicitly. Comma-separated
# values produce multiple listeners sharing the same PORT. IPv6
# literals must be bracketed.
#
# Examples:
#   BIND=*                 # all interfaces (the pre-loopback-default behavior)
#   BIND=0.0.0.0           # all IPv4 interfaces
#   BIND=127.0.0.1         # IPv4 loopback only
#   BIND=127.0.0.1,10.0.0.5  # loopback + one LAN address
#BIND=

# TCP port to listen on. The server listens on BIND:PORT.
#PORT=8093

# Set to any value to enable gin debug logging.
#DEBUG=

# HTTP Basic Auth. Both must be set together, or both unset.
#HTTP_USER=
#HTTP_PASSWORD=
