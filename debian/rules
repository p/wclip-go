#!/usr/bin/make -f

export DH_VERBOSE = 1
export GOTOOLCHAIN = local
# Build inside the source tree to avoid GOPATH gymnastics.
export GOFLAGS = -mod=mod
export GOCACHE = $(CURDIR)/.gocache
export GOMODCACHE = $(CURDIR)/.gomodcache

VERSION := $(shell dpkg-parsechangelog -SVersion)

%:
	dh $@

override_dh_auto_build:
	mkdir -p build
	go build -trimpath -ldflags='-s -w -X main.version=$(VERSION)' -o build/wclip ./src

override_dh_auto_test:
	go test ./src/...

override_dh_auto_clean:
	chmod -R u+w .gocache .gomodcache 2>/dev/null || true
	rm -rf build .gocache .gomodcache

override_dh_auto_install:
	install -D -m 0755 build/wclip debian/wclip/usr/bin/wclip

# Install the systemd unit but do not enable or start it on fresh
# install. The operator must explicitly opt in via
#   sudo systemctl enable --now wclip
# Upgrade behavior is unchanged: if a user has already enabled and
# started the service, dh_installsystemd will still restart it.
override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start
